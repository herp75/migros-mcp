{
  "name": "migros-mcp",
  "version": "0.5.1",
  "description": "MCP server for Migros Switzerland: search products, get nutrition info, find stores, and (with credentials) manage your basket and order history",
  "main": "dist/index.js",
  "bin": {
    "migros-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "live-check": "node scripts/live-check.mjs",
    "prepublishOnly": "npm run build",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-lines=80 tests/**/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write src tests scripts eslint.config.js",
    "format:check": "prettier --check src tests scripts eslint.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "live-account": "node scripts/live-account-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herp75/migros-mcp.git"
  },
  "homepage": "https://github.com/herp75/migros-mcp",
  "bugs": {
    "url": "https://github.com/herp75/migros-mcp/issues"
  },
  "author": "lewpgs and contributors (fork: herp75)",
  "keywords": [
    "mcp",
    "migros",
    "switzerland",
    "grocery",
    "nutrition",
    "model-context-protocol"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.15.2",
    "migros-api-wrapper": "^1.1.37",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.21",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=22"
  }
}
